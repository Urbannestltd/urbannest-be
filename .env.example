# Copy to .env and fill in real values. Never commit real secrets.

PORT=4000
NODE_ENV=development

# RS256 keypair for signing/verifying JWT access tokens.
JWT_SECRET=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Prisma / PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Google login (not yet wired up live, see docs/backend-handoff.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
RESEND_API_KEY=
MAIL_USER=
MAIL_PASS=
ZEPTOMAIL_BASE_URL=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_NAME=
ZEPTOMAIL_FROM_EMAIL=

# Base URLs used in emails/links and outbound calls
BASE_URL=
API_BASE_URL=

# VTpass (utility bill payments)
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_API_KEY=

# Paystack (payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=

# Supabase (file storage, signed uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron endpoint auth — must be set in every environment that exposes /cron/*
CRON_SECRET=

# CORS allowlist override (comma-separated). Defaults to the known dev/prod
# frontend URLs hardcoded in src/app.ts if unset.
ALLOWED_ORIGINS=

# Upstash Redis — shared rate-limit store across serverless instances.
# Leave unset to fall back to in-memory (per-instance) rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
